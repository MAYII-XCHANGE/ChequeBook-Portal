# Copy these values into your shell, IDE run configuration, or secret store.
# Never commit real test or production credentials.
SPRING_PROFILES_ACTIVE=local
PORT=8080
REST_CLIENT_CONNECT_TIMEOUT=15s
REST_CLIENT_READ_TIMEOUT=45s


# Use a random value of at least 32 characters and keep it in the deployment secret store.
JWT_SECRET=replace-with-a-long-random-signing-secret
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000


CHEQUEBOOK_ACK_OBTAINED_FLAG=N
CHEQUEBOOK_INVENTORY_REQUIRED=N

CHEQUE_CHARGE_50=1000
CHEQUE_CHARGE_100=2000
VENDOR_EXPORT_DIRECTORY=./data/vendor-exports
VENDOR_DELIVERY_SOL_ID=001
VENDOR_DELIVERY_ADDRESS=23 KOFO ABAYOMI STREET, VICTORIA ISLAND, LAGOS
VENDOR_SCHEME_CODE_OVERRIDE=

